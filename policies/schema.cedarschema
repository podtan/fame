// Fame Cedar schema — EMPTY NAMESPACE (v0.1.2).
//
// CRITICAL: pep builds all Cedar UIDs WITHOUT a namespace:
//   principal → User::"<sub>"        (pep::cedar::build_principal_uid)
//   action    → Action::"<Name>"     (pep::cedar::build_action_uid)
//   resource  → <Type>::"<id>"       (pep::cedar::entity::ResourceInfo)
// This schema must therefore be empty-namespace too. The previous
// Podtan::-namespaced form did not even parse ("unexpected token `::`"),
// which made CedarAuthorizer init fail → fame booted FAIL-OPEN with zero
// authorization checks (since v0.1.0).
//
// Resource types are derived from entity config slugs via
// entity_config::slug_to_cedar_type ("semantic-memory" → SemanticMemory).
// Cedar identifiers may not contain spaces or hyphens, so the display
// `name` from the entity TOML ("Semantic Memory") cannot be used directly.

entity User = {
    email?: String,
    name?: String,
    preferred_username?: String,
    role?: String,
    groups?: Set<String>,
};

entity SemanticMemory = {
    title?: String,
    domain?: String,
};

entity EpisodicMemory = {
    title?: String,
    domain?: String,
};

entity ProceduralMemory = {
    title?: String,
    domain?: String,
};

entity AgentIdentity = {
    title?: String,
    agent_id?: String,
};

action "CreateSemanticMemory" appliesTo { principal: User, resource: SemanticMemory };
action "ViewSemanticMemory" appliesTo { principal: User, resource: SemanticMemory };
action "EditSemanticMemory" appliesTo { principal: User, resource: SemanticMemory };
action "DeleteSemanticMemory" appliesTo { principal: User, resource: SemanticMemory };

action "CreateEpisodicMemory" appliesTo { principal: User, resource: EpisodicMemory };
action "ViewEpisodicMemory" appliesTo { principal: User, resource: EpisodicMemory };
action "EditEpisodicMemory" appliesTo { principal: User, resource: EpisodicMemory };
action "DeleteEpisodicMemory" appliesTo { principal: User, resource: EpisodicMemory };

action "CreateProceduralMemory" appliesTo { principal: User, resource: ProceduralMemory };
action "ViewProceduralMemory" appliesTo { principal: User, resource: ProceduralMemory };
action "EditProceduralMemory" appliesTo { principal: User, resource: ProceduralMemory };
action "DeleteProceduralMemory" appliesTo { principal: User, resource: ProceduralMemory };

action "CreateAgentIdentity" appliesTo { principal: User, resource: AgentIdentity };
action "ViewAgentIdentity" appliesTo { principal: User, resource: AgentIdentity };
action "EditAgentIdentity" appliesTo { principal: User, resource: AgentIdentity };
action "DeleteAgentIdentity" appliesTo { principal: User, resource: AgentIdentity };
