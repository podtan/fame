{
  "openapi": "3.1.0",
  "info": {
    "title": "Fame — Facade for Agent Memory",
    "description": "Memory facade over PDT. Provides semantic, episodic, and procedural memory per agent.\n\nAgent identity is passed via X-Instance-Id header (injected by Aether). The agent never sees or passes agent_id — the URL path to Fame (https://fame.example.com/{agent_id}/sse) tells Aether which agent to route to, and Aether injects X-Instance-Id.",
    "contact": {
      "name": "Podtan Team"
    },
    "license": {
      "name": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/episodic-memorys": {
      "get": {
        "tags": [
          "entities"
        ],
        "operationId": "list_episodic-memorys",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Filter by status",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "archived"
              ]
            }
          },
          {
            "name": "attached_to",
            "in": "query",
            "description": "Filter by relation target (e.g. project ID)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Max rows returned. DEFAULT 20 (newest-first by updated_at) — a naive list call can never flood a context. Response always carries the true total + returned. Pass a larger limit (e.g. 10000) for a deliberate full inventory.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "verbose",
            "in": "query",
            "description": "Full list rows: 200-char title, created_at, family metadata (consolidated/outcome/source), full-precision updated_at. Default false = slim rows (id, title <=80, status, updated_at minute-precision UTC). Full content is GET-by-id only in both shapes.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of episodic-memorys",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Episodic MemoryListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "entities"
        ],
        "operationId": "create_episodic-memory",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEpisodic MemoryRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Episodic Memory created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Episodic Memory"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/episodic-memorys/{id}": {
      "get": {
        "tags": [
          "entities"
        ],
        "operationId": "get_episodic-memory",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Episodic Memory details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Episodic Memory"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/episodic-memorys/{id}/status": {
      "patch": {
        "tags": [
          "entities"
        ],
        "operationId": "update_episodic-memory_status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "archived"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Episodic Memory"
                }
              }
            }
          }
        }
      }
    },
